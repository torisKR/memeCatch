# ══ 환경 분리 규칙 (넘기지 말 것) ══════════════════════════════
#   .env.development → 로컬 Supabase(http://127.0.0.1:54321). `next dev`가 읽는다.
#   .env.production  → 원격 Supabase(https://<project>.supabase.co).
#                      로컬 `next build && next start`가 읽는다.
#                      실제 Vercel 배포는 이 파일이 아니라 대시보드 환경변수를 쓴다.
#   .env.local       → 쓰지 말 것. dev·prod 양쪽에서 위 둘보다 우선 적용되어
#                      분리를 무력화한다(과거 사고 원인).
# 로컬 값은 `supabase start` 출력에서, 원격 값은 프로젝트 설정 → API에서 가져온다.

# ─── Supabase (필수) ─────────────────────────────────────────────
# 로컬: `supabase start` 출력값 / 프로덕션: 프로젝트 설정 → API
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 — 배치·관리·시드 스크립트에서만 사용 (클라이언트 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=

# ─── Latpeed 멤버십 (MemeCatch Plus) ─────────────────────────────
# 서버 전용. 상품 URL은 https://latpeed.com/products/... 형식만 허용됩니다.
LATPEED_MEMBERSHIP_URL=
# Latpeed 상품별 외부 툴 연동에서 생성한 웹훅 시크릿 (클라이언트 노출 금지)
LATPEED_WEBHOOK_SECRET=
# Latpeed payload가 productId를 제공할 때만 설정하는 선택적 추가 검증값
LATPEED_MEMBERSHIP_PRODUCT_ID=

# ─── Unifi Apps 결제 (MemeCatch Plus) ────────────────────────────
# clientId/clientSecret은 Unifi 팀에서 발급받습니다(콘솔 → Real API Key 발급).
# clientId는 콘솔에 도메인을 등록해야 활성화됩니다.
# 클라이언트 노출값 — SDK 초기화에 필요합니다. 비워두면 기존 Latpeed 결제를 씁니다.
NEXT_PUBLIC_UNIFI_CLIENT_ID=
# 1001 = Kairos 테스트넷, 8217 = Kaia 메인넷
NEXT_PUBLIC_UNIFI_CHAIN_ID=1001
# 서버 전용 (절대 클라이언트 노출 금지) — 결제 생성·조회에 사용
UNIFI_CLIENT_ID=
UNIFI_CLIENT_SECRET=
# 안전장치: 기본값이 테스트 모드입니다. 실결제는 명시적으로 false로 전환하세요.
UNIFI_TEST_MODE=true
# 기본 https://payment.dappportal.io — 보통 비워둡니다.
UNIFI_PAYMENT_BASE_URL=

# ─── 사이트 ──────────────────────────────────────────────────────
# canonical·OG·sitemap·llms.txt의 절대 URL 기준 (프로덕션: https://catchmeme.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── 피처 플래그 ─────────────────────────────────────────────────
NEXT_PUBLIC_COMMUNITY_ENABLED=false
NEXT_PUBLIC_SUBMISSIONS_OPEN=true

# ─── 분석·수익화 (선택 — 비우면 해당 기능 비활성) ─────────────────
# GA4 측정 ID (G-…) — 설정 시 gtag 자동 로드 (@next/third-parties)
NEXT_PUBLIC_GA_ID=
# AdSense 게시자 ID (ca-pub-…) — 설정 시 adsbygoogle 스크립트 + 계정 메타 활성
# (ads.txt는 public/ads.txt 정적 파일로 별도 관리)
NEXT_PUBLIC_ADSENSE_CLIENT=

# ─── Cloudflare R2 (선택 — 제보 이미지 저장소) ────────────────────
# 전부 서버 전용(lib/r2.server.ts). 4종이 비면 Supabase Storage로 자동 폴백.
# 대시보드 → R2 → API 토큰(Object Read & Write, 버킷 한정)에서 발급
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=memecatch-uploads

# ─── 관리자 AI (선택) ────────────────────────────────────────────
# 관리자 검수 화면의 밈 설명 초안 및 오프라인 다국어 번역 배치(서버 전용)
# 번역은 페이지 요청 중 생성하지 않습니다. 아래 service-role 키와 함께
# `pnpm translate:memes -- --locale=en --limit=20 --status=missing`처럼 실행합니다.
ANTHROPIC_API_KEY=
# 선택: 미설정 시 scripts/translate-memes.mjs의 검증된 기본 모델 사용
ANTHROPIC_TRANSLATION_MODEL=

# ─── 소셜 콘텐츠 oEmbed (선택) ───────────────────────────────────
# TikTok과 Meta(Facebook·Instagram·Threads) 공개 oEmbed는 키 없이 동작합니다.
# Meta Graph API 기본 버전만 필요할 때 재정의하세요.
META_GRAPH_API_VERSION=v25.0

# ─── YouTube Data API (선택) ─────────────────────────────────────
# 출처 후보 발견·메타데이터 재확인용. 서버 전용 (클라이언트 노출 금지).
# 영상 파일은 저장하지 않고 메타데이터만 조회합니다.
YOUTUBE_API_KEY=

# ─── TikTok Login Kit (선택) ────────────────────────────────────
# TikTok Developer Portal의 Login Kit 승인 후 서버 환경에만 설정합니다.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://catchmeme.com/auth/tiktok/callback

# Adpick ShoppingMate hotdeal sync (server only)
ADPICK_AFFILIATE_ID=
CRON_SECRET=
