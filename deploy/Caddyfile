{
	email {$ACME_EMAIL:ops@catchmeme.com}
	servers {
		trusted_proxies static {$CLOUDFLARE_TRUSTED_PROXIES}
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

# Cloudflare Authenticated Origin Pulls (docs/oci-setup.md, PLAN.md D5-6):
# with CLOUDFLARE_ORIGIN_PULL=on, a TLS client must present a certificate
# Cloudflare's origin-pull CA signed, so only Cloudflare reaches the site and
# a peer inside Cloudflare's ranges cannot connect straight to the origin with
# a forged CF-Connecting-IP. Off by default. Turn on the Cloudflare dashboard
# toggle first, then this setting; any value but on/off stops Caddy.
(origin-pull-off) {
}

(origin-pull-on) {
	tls {
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy/cloudflare-origin-pull-ca.pem
		}
	}
}

{$SITE_ADDRESS:catchmeme.com} {
	import origin-pull-{$CLOUDFLARE_ORIGIN_PULL:off}

	# www.catchmeme.com answered 200 with the apex content, and Bing crawled a
	# separate www sitemap. Send page and file requests to the apex with the same
	# path and query. This only runs when SITE_ADDRESS on the VM lists
	# www.catchmeme.com; proxy.ts (wwwApexRedirect) applies the same rule in the
	# app, so the redirect holds either way. /api/* stays on www so OAuth
	# callbacks and webhooks registered with www keep working, and only GET/HEAD
	# move so a POST is never turned into a GET.
	@www_to_apex {
		host www.catchmeme.com
		method GET HEAD
		not path /api/* /auth/callback /auth/callback/* /auth/tiktok/callback /auth/tiktok/callback/*
	}
	redir @www_to_apex https://catchmeme.com{uri} 301

	encode gzip
	reverse_proxy app:3000
}
