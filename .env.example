# ─── Self-host (OCI VM /opt/memecatch) ───────────────────────────
# The app reads DATABASE_URL. It does not call Supabase over HTTP.
# Compose interpolates the passwords below. See docs/oci-setup.md.
DATABASE_URL=postgresql://memecatch:change-me@postgres:5432/memecatch
MEMECATCH_DB_PASSWORD=change-me
MEMECATCH_BACKUP_DB_PASSWORD=change-me
POSTGRES_PASSWORD=change-me
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://catchmeme.com
AUTH_EMAIL_WEBHOOK=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
LOCAL_OBJECT_STORAGE_DIR=
OBJECT_SIGNING_SECRET=
MEMECATCH_SIGNING_SECRET=
MEMECATCH_CADDY=
R2_BACKUP_BUCKET=
BACKUP_RETENTION_DAYS=14
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_IDENTITY=
MEMECATCH_RESTORE_CONFIRM=
MEMECATCH_IMAGE=memecatch:local
SITE_ADDRESS=catchmeme.com

# ══ 환경 분리 규칙 (넘기지 말 것) ══════════════════════════════
#   .env.development → 로컬 Supabase(http://127.0.0.1:54321). `next dev`가 읽는다.
#   .env.production  → 원격 Supabase(https://<project>.supabase.co).
#                      로컬 `next build && next start`가 읽는다.
#                      실제 Vercel 배포는 이 파일이 아니라 대시보드 환경변수를 쓴다.
#   .env.local       → 만들지 말 것. dev·prod 양쪽에서 위 둘보다 우선 적용되어
#                      분리를 무력화한다(과거 사고 원인).
# 로컬 값은 `supabase start` 출력에서, 원격 값은 프로젝트 설정 → API에서 가져온다.

# ─── Supabase (필수) ─────────────────────────────────────────────
# 로컬: `supabase start` 출력값 / 프로덕션: 프로젝트 설정 → API
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 — 배치·관리·시드 스크립트에서만 사용 (클라이언트 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=

# ─── Latpeed legacy (기존 결제 감사·호환 전용) ───────────────────
# 신규 checkout에는 사용하지 않습니다. 기존 Latpeed 이력을 처리해야 할 때만 설정합니다.
LATPEED_WEBHOOK_SECRET=
LATPEED_MEMBERSHIP_PRODUCT_ID=

# ─── Unifi Wallet 로그인 SDK (공개 client ID만 브라우저에 전달) ───
NEXT_PUBLIC_UNIFI_CLIENT_ID=

# ─── 사이트 ──────────────────────────────────────────────────────
# canonical·OG·sitemap·llms.txt의 절대 URL 기준 (프로덕션: https://catchmeme.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── 피처 플래그 ─────────────────────────────────────────────────
NEXT_PUBLIC_COMMUNITY_ENABLED=false
NEXT_PUBLIC_SUBMISSIONS_OPEN=true

# ─── 분석·수익화 (선택 — 비우면 해당 기능 비활성) ─────────────────
# GA4 측정 ID (G-…) — 설정 시 gtag 자동 로드 (@next/third-parties)
NEXT_PUBLIC_GA_ID=
# AdSense 게시자 ID (ca-pub-…) — 계정 소유권 확인 메타태그에 사용
# (ads.txt는 public/ads.txt 정적 파일로 별도 관리)
NEXT_PUBLIC_ADSENSE_CLIENT=
# 기본 false: 검증용 메타태그만 유지하고 Auto Ads 런타임을 시작하지 않음.
# 승인·동의 설정·페이지 제외를 운영자가 확인한 뒤에만 true로 변경.
# SPA에서는 스크립트 제거만으로 이전에 실행된 자동 광고가 종료되지 않음.
ADSENSE_AUTO_ADS_ENABLED=false

# ─── Cloudflare R2 (선택 — 제보 이미지 저장소) ────────────────────
# 전부 서버 전용(lib/r2.server.ts). 4종이 비면 Supabase Storage로 자동 폴백.
# 대시보드 → R2 → API 토큰(Object Read & Write, 버킷 한정)에서 발급
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=memecatch-uploads

# Offline poster backfill only (scripts/backfill-meme-art.mjs). Leave empty.
# The site never reads this during a request.
GROK_IMAGE_API_KEY=

# ─── MPE 미디어 처리 (서버·worker 전용) ─────────────────────────
# OpenRouter에서 발급한 키만 사용합니다. OPENAI_API_KEY와 혼용하지 않습니다.
# Vercel 서버와 MPE worker 양쪽에 동일하게 주입하되 클라이언트에는 노출하지 않습니다.
OPENROUTER_API_KEY=
# 공개 밈 챗봇은 같은 키와 openrouter/free를 사용하며 유료 제공자로 전환하지 않습니다.
# false로 설정하면 생성 호출 없이 공개 밈 검색 결과와 요약만 제공합니다.
MEME_CHAT_GENERATION_ENABLED=true
# 로컬 opencodex를 사용할 때만 선택합니다. 운영 Vercel은 Mac의 localhost에 접근할 수 없습니다.
MEME_CHAT_PROVIDER=openrouter
# opencodex 선택 시 로컬 loopback 주소만 허용하며 기존 키가 있으면 서버에서만 사용합니다.
MEME_CHAT_BASE_URL=http://127.0.0.1:10100/v1
MEME_CHAT_MODEL=gpt-6.1-sol
MEME_CHAT_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OCR·근거 초안. 이 값은 stealth/ox-alpha로 고정되며 다른 값은 런타임에서 거부됩니다.
OPENROUTER_MPE_MODEL=stealth/ox-alpha
# 정확히 stealth/ox-alpha, 비용 $0만 허용합니다. 유료 폴백·자동 공개·외부 원본 미디어 영속 저장은 금지합니다.

# ─── 관리자 자체 밈 초안 생성 (선택, 서버 전용) ────────────────
# MPE와 분리된 관리자 house-original 전용 경로입니다. public Studio는 템플릿만 사용합니다.
BEDROCK_MEME_STUDIO_ENABLED=false
AWS_REGION=ap-northeast-2
# Vercel OIDC로 assume할 최소권한 IAM role ARN. 정적 AWS access key는 사용하지 않습니다.
AWS_ROLE_ARN=
# Claude Sonnet 5 global profile(global.anthropic.claude-sonnet-5) 비용 예약용 nano-USD/token 단가입니다.
BEDROCK_MEME_STUDIO_INPUT_NANO_USD_PER_TOKEN=3000
BEDROCK_MEME_STUDIO_OUTPUT_NANO_USD_PER_TOKEN=15000
# 앱 lifetime hard cap은 $100입니다. 1회 3개 초안을 만들며 저장 시 pending이고 자동 게시하지 않습니다.

# ─── 관리자 AI 검수 (선택) ─────────────────────────────────────
# 관리자 검수 화면의 밈 설명 초안은 서버 전용 GPT-5.6 Sol high를 사용합니다.
OPENAI_API_KEY=

# 의미 검색: 고정된 multilingual-e5-small-v1(384차원) corpus와 동일한 모델 서버만 연결합니다.
# 기본 off. 로컬은 scripts/meme_embeddings.py serve, 운영은 동일 모델의 HTTPS 경로를 씁니다.
# bundled: Vercel CPU에서 고정 FP32 ONNX 실행. 기존 CRON_SECRET로 요청 서명(새 키 불필요).
# 빌드 시 모델 검증·포함. Vercel Fluid / Large Functions Beta가 필요합니다.
MEME_EMBEDDING_RUNTIME=
MEME_SEMANTIC_SEARCH_ENABLED=false
# 변경분 일일 색인: 실제 Linux512토큰 메모리 검증 뒤 true. 기존 CRON_SECRET 사용.
MEME_EMBEDDING_REINDEX_ENABLED=false
MEME_EMBEDDING_URL=http://127.0.0.1:8766/v1/embeddings
MEME_EMBEDDING_API_KEY=
# 관리자 검수 모델은 gpt-5.6-sol로 고정되며 reasoning effort는 high입니다.
# 기본값: https://api.openai.com/v1. 비워 두면 기본 OpenAI API를 사용합니다.
OPENAI_REVIEW_BASE_URL=https://api.openai.com/v1
# 오프라인 다국어 번역 배치는 별도 실행 경로이며 페이지 요청 중 생성하지 않습니다.

# ─── Radar 외부 신호 (선택, 전부 서버 전용) ──────────────────────
# X·Threads는 텍스트 게시물만 요청하고 미디어는 무시합니다.
# X API는 pay-per-use이므로 RADAR_X_TERMS를 작게 유지하고 콘솔 spending limit을 설정하세요.
X_API_BEARER_TOKEN=
RADAR_X_TERMS=
# Threads keyword_search 승인 전에는 인증 사용자 소유 게시물만 검색됩니다.
THREADS_ACCESS_TOKEN=
RADAR_THREADS_TERMS=
# Instagram 공개 발견은 Facebook Login 기반 Professional 계정의 Hashtag Search만 사용합니다.
# 최대 30개 해시태그/rolling 7일. 원본 이미지·영상 파일과 media_url은 저장하지 않습니다.
META_INSTAGRAM_ACCESS_TOKEN=
META_INSTAGRAM_USER_ID=
RADAR_INSTAGRAM_HASHTAGS=
META_GRAPH_API_VERSION=v26.0

# ─── 소셜 콘텐츠 oEmbed (선택) ───────────────────────────────────
# TikTok과 Meta(Facebook·Instagram·Threads) 공개 oEmbed는 키 없이 동작합니다.

# ─── YouTube Data API (선택) ─────────────────────────────────────
# 출처 후보 발견·메타데이터 재확인용. 서버 전용 (클라이언트 노출 금지).
# 영상 파일은 저장하지 않고 메타데이터만 조회합니다.
YOUTUBE_API_KEY=

# ─── TikTok Login Kit (선택) ────────────────────────────────────
# TikTok Developer Portal의 Login Kit 승인 후 서버 환경에만 설정합니다.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://catchmeme.com/auth/tiktok/callback

# Adpick ShoppingMate hotdeal sync (server only)
ADPICK_AFFILIATE_ID=
CRON_SECRET=
PLUS_DIGEST_DELIVERY_URL=
PLUS_DIGEST_DELIVERY_TOKEN=
PLUS_DIGEST_FROM_EMAIL=

# Plus Web Push. 공개 키만 NEXT_PUBLIC_ 접두사로 클라이언트에 노출합니다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@catchmeme.com


# ─── Unifi Pay 결제 링크 (MemeCatch Plus $10 USD / USDT on Kaia) ─
# 신규 checkout의 canonical 결제 경로입니다.
# 기본/production은 false입니다. 격리 Preview의 실제 test checkout 생성 순간에만 true로 두고 즉시 false로 복구합니다.
# webhook/refund에는 적용하지 않습니다.
UNIFI_PAY_CHECKOUT_ENABLED=false
# 콘솔 → Real API Key 발급. HMAC 서명에 사용하며 클라이언트 노출 금지.
UNIFI_PAY_API_KEY=
UNIFI_PAY_API_SECRET=
UNIFI_PAY_STORE_ID=
# Preview(테스트): https://app-api-pay.unifi.me / 운영: https://api-pay.unifi.me
UNIFI_PAY_BASE_URL=https://app-api-pay.unifi.me
# 콘솔 '콜백 도메인' 허용 목록에 등록된 도메인이어야 한다.
UNIFI_PAY_CALLBACK_BASE_URL=
UNIFI_PAY_RETURN_BASE_URL=
# 통화는 USD 또는 JPY만 지원(KRW 불가)
UNIFI_PAY_CURRENCY=USD
UNIFI_PAY_ITEM_PRICE=10

# Fairy: configure only after the dedicated project and signed webhook are ready.
# Without all four values the Plus donation option and its endpoints stay disabled.
FAIRY_PLUS_ENABLED=false
FAIRY_PROJECT_SLUG=memecatch
FAIRY_WEBHOOK_SECRET=
# Minimum qualifying ONE-OFF donation in KRW; one payment grants 30 days.
FAIRY_PLUS_MIN_AMOUNT_KRW=15000

# ─── ACT-001 격리 preview (운영 셸/CI에만 주입, 저장소 커밋 금지) ─
ACT001_PREFLIGHT_BASE_URL=
ACT001_PREFLIGHT_SUPABASE_URL=
ACT001_PREFLIGHT_SUPABASE_ANON_KEY=
# active preview 사용자로 제한된 단기 JWT. service_role 키를 사용하지 않습니다.
ACT001_PREFLIGHT_SUPABASE_PREVIEW_JWT=
# prerequisite/closure 공통 read-only OpenAPI catalog probe 전용. artifact·로그·브라우저 노출 금지.
ACT001_PREFLIGHT_SUPABASE_SERVICE_ROLE_KEY=
ACT001_EVIDENCE_MANIFEST=
# closure 증적이 manifest와 다른 파일일 때만 설정하는 선택 경로입니다.
ACT001_CLOSURE_EVIDENCE=
# manifest의 appUrl/supabaseUrl과 정확히 일치해야 하며 production origin과 달라야 합니다.
ACT001_PREVIEW_APP_ORIGIN=
ACT001_PREVIEW_SUPABASE_ORIGIN=
# preview와의 불일치 검증에 필수입니다. 실제 production credential은 입력하지 않습니다.
ACT001_PRODUCTION_APP_ORIGIN=
ACT001_PRODUCTION_SUPABASE_ORIGIN=
# Preview write matrix 전용. 네 JWT는 서로 다른 sub를 가져야 합니다.
ACT001_PREVIEW_SUPABASE_ANON_KEY=
ACT001_PREVIEW_OWNER_JWT=
ACT001_PREVIEW_FREE_JWT=
ACT001_PREVIEW_EXPIRED_JWT=
ACT001_PREVIEW_CROSS_OWNER_JWT=
# 기존 DB/RLS 상태 조회 전용이며 브라우저·artifact·로그에 노출하지 않습니다.
ACT001_PREVIEW_SUPABASE_SERVICE_ROLE_KEY=
ACT001_PREVIEW_REFUND_SERVICE_ROLE_KEY=
# MPE worker: 빈 큐는 2초→4초→8초→…→30초 간격, 작업 처리 후 2초로 복귀.
# 고정 간격이 필요하면 두 값을 동일하게 지정. 실행 중 worker는 재시작 후 적용.
MPE_WORKER_POLL_MS=2000
MPE_WORKER_MAX_IDLE_POLL_MS=30000
