# Local default. Change HOST to 0.0.0.0 only behind a trusted HTTPS reverse proxy.
HOST=127.0.0.1
PORT=8787
ALLOWED_ORIGINS=https://chatgpt.com

# Optional events: all four values are required. Leave blank to disable events.
# Generate/store real values with your secret manager, never in source control.
# The bearer token is for one private operator; public distribution needs OAuth.
MCP_OPERATOR_TOKEN=
EVENT_STATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=
# Exact HTTPS origin supplied by the actual subscribing ChatGPT client.
# No wildcard origins. Do not guess a callback hostname.
EVENT_CALLBACK_ORIGINS=
EVENT_STATE_PATH=./state/events.enc

# Local browser preview only; disabled by default and blocked on remote binding.
MEMECATCH_PREVIEW=0
