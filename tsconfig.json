{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // scripts/*.mts는 Node 24가 타입 스트리핑으로 직접 실행한다. Node는 확장자를
    // 생략할 수 없어 import 경로에 .ts/.mts가 그대로 붙는다. noEmit이 켜져 있으므로
    // 이 옵션은 tsc의 검사 범위만 넓히고 산출물에는 영향을 주지 않는다.
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "cloudflare", ".open-next", ".wrangler"]
}
