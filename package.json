{
  "name": "memecatch",
  "version": "0.1.0",
  "private": true,
  "comment:browserslist": "현대 브라우저 타깃(2023+) — 레거시 폴리필/불필요 트랜스파일 제거로 번들·TBT 축소. 모바일 우선 한국 사용자 대상.",
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4",
    "ios_saf >= 16.4",
    "samsung >= 23",
    "not dead"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prepare-meme-embedding-model.mjs --if-enabled && next build --webpack",
    "embeddings:prepare": "node scripts/prepare-meme-embedding-model.mjs",
    "embeddings:prepare:test": "node --test scripts/prepare-meme-embedding-model.test.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:review-international-origins": "node scripts/review-international-meme-origins.mjs",
    "content:ingest": "node scripts/ingest-meme-content.mjs",
    "content:ingest:test": "node --test scripts/ingest-meme-content.test.mjs",
    "smoke": "node scripts/smoke.mts",
    "mpe:worker": "node --experimental-strip-types scripts/mpe-media-worker.mjs --watch",
    "mpe:worker:once": "node --experimental-strip-types scripts/mpe-media-worker.mjs",
    "mpe:worker:drain": "node --experimental-strip-types scripts/mpe-media-worker.mjs --drain",
    "quality:check": "node scripts/quality-check.mts",
    "quality:report": "node scripts/quality-check.mts --json --fail-on=none",
    "import:koculture": "node scripts/import-koculture-memes.mjs",
    "translation:check": "node scripts/translation-batch-check.mjs --artifact-dir artifacts/renewal/loop-050 --worklist artifacts/renewal/loop-050/worklist.json",
    "translation:check:complete": "node scripts/translation-batch-check.mjs --artifact-dir artifacts/renewal/loop-050 --worklist artifacts/renewal/loop-050/worklist.json --require-complete",
    "translation:intake": "node scripts/translation-intake.mjs",
    "translation:intake:test": "node scripts/translation-intake.test.mjs",
    "translation:demand-report": "node scripts/translation-demand-report.mjs",
    "translation:demand-report:test": "node scripts/translation-demand-report.test.mjs",
    "plus:activation:local": "node scripts/plus-activation-local.mjs",
    "plus:activation:evidence": "node scripts/plus-activation-evidence.mjs",
    "plus:activation:evidence:test": "node scripts/plus-activation-evidence.test.mjs",
    "plus:activation:preflight": "node scripts/plus-activation-preflight.mjs",
    "plus:activation:preflight:test": "node scripts/plus-activation-preflight.test.mjs",
    "plus:activation:preview": "node scripts/plus-activation-preview.mjs",
    "plus:activation:preview:test": "node scripts/plus-activation-preview.test.mjs",
    "translate:memes:mlx-linked:test": "node scripts/translate-memes-mlx-linked.test.mjs",
    "translate:memes": "node scripts/translate-memes.mjs",
    "translate:memes:mlx-linked": "node scripts/translate-memes-mlx-linked.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1121.0",
    "@huggingface/transformers": "3.8.1",
    "@linenext/dapp-portal-sdk": "^1.6.0",
    "@next/third-parties": "^16.3.4",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@serwist/next": "^9.5.12",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.1",
    "@vercel/oidc-aws-credentials-provider": "^3.3.5",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-auto-scroll": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "kysely": "^0.29.8",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "next": "16.3.4",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "serwist": "^9.5.12",
    "tailwind-merge": "^3.6.0",
    "three": "0.186.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "axios@>=1.0.0 <1.18.0": "1.19.0",
      "brace-expansion@<2": "1.1.18",
      "brace-expansion@>=4 <6": "5.0.9",
      "baseline-browser-mapping@>=2 <3": "2.11.0",
      "browserslist@<=4.28.6": "4.28.7",
      "js-yaml@>=4 <5": "4.3.2",
      "undici@>=7 <8": "7.29.0"
    }
  }
}
